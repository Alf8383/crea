{
  "name": "crea",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "assistant": "node --env-file-if-exists=.env.local server/assistant.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:assistant": "node --test tests/assistant/server.test.mjs",
    "test:rules": "vitest run --config vitest.rules.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:firebase": "playwright test --config playwright.firebase.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/react": "0.1.0-beta.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "lucide-react": "^1.73.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.19.0"
}
