# Modo de demostración explícito (omite Auth y Firestore).
NEXT_PUBLIC_CREA_DEMO=true

# Para usar cuentas reales, cambia NEXT_PUBLIC_CREA_DEMO a false y completa estos valores.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Activa solo para pruebas con Firebase Emulator Suite y un proyecto demo-*.
NEXT_PUBLIC_CREA_EMULATORS=false

# Opcional. El sitio estático usa contenido local cuando esta URL está vacía.
NEXT_PUBLIC_CREA_ASSISTANT_URL=
# Variables exclusivas del backend. Configúralas en .env.local o en el servidor.
CREA_ASSISTANT_ORIGIN=http://localhost:3000
CREA_ASSISTANT_PORT=3200
CREA_ASSISTANT_MODEL=
OPENAI_API_KEY=
